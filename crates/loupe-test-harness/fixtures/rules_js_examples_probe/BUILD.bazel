"""Probe BUILD exercising every public rules_js rule.

Goal: surface every API gap in Loupe by analyzing one of each.
Targets are intentionally minimal (no real npm deps) so a Loupe
failure is unambiguously a missing engine API, not a missing
external repo.

Public rules covered:
- @aspect_rules_js//js:defs.bzl: js_binary, js_test, js_library,
  js_run_binary, js_run_devserver, js_info_files, js_image_layer
- @aspect_rules_js//js:providers.bzl: js_info
- @aspect_rules_js//npm:defs.bzl: npm_package, npm_link_package,
  stamped_package_json
"""

load("@aspect_rules_js//js:defs.bzl", "js_binary", "js_image_layer", "js_info_files", "js_library", "js_run_binary", "js_run_devserver", "js_test")
load("@aspect_rules_js//js:providers.bzl", "js_info")
load("@aspect_rules_js//npm:defs.bzl", "npm_package", "stamped_package_json")

# --- js_library ---------------------------------------------------------
js_library(
    name = "lib",
    srcs = [
        "lib.js",
        "package.json",
    ],
)

# --- js_binary ----------------------------------------------------------
js_binary(
    name = "bin",
    data = [":lib"],
    entry_point = "main.js",
)

# --- js_test ------------------------------------------------------------
js_test(
    name = "test",
    entry_point = "test.js",
)

# --- js_run_binary ------------------------------------------------------
js_run_binary(
    name = "run_bin",
    srcs = [],
    outs = ["run_bin.out"],
    args = ["$(execpath run_bin.out)"],
    tool = ":bin",
)

# --- js_run_devserver ---------------------------------------------------
js_run_devserver(
    name = "devserver",
    tool = ":bin",
)

# --- js_info_files ------------------------------------------------------
js_info_files(
    name = "lib_files",
    srcs = [":lib"],
)

# --- js_image_layer -----------------------------------------------------
js_image_layer(
    name = "img_layer",
    binary = ":bin",
)

# --- npm_package --------------------------------------------------------
npm_package(
    name = "pkg",
    srcs = [
        "lib.js",
        "package.json",
    ],
)

# --- stamped_package_json (must be named "package") ---------------------
stamped_package_json(
    name = "package",
    stamp_var = "STABLE_VERSION",
)
