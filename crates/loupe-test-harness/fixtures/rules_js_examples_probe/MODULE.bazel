module(name = "rules_js_examples_probe", version = "0.0.0")

bazel_dep(name = "aspect_rules_js", version = "2.1.3")
bazel_dep(name = "rules_nodejs", version = "6.7.3")
bazel_dep(name = "aspect_bazel_lib", version = "2.7.2")
bazel_dep(name = "platforms", version = "0.0.10")
bazel_dep(name = "bazel_skylib", version = "1.7.1")

# aspect_bazel_lib 2.8+ registers a `zstd_toolchain` keyed off
# `@local_config_platform`. Bazel 9 no longer auto-synthesises that
# repo, so toolchain resolution fails before vendoring finishes.
# Pin to 2.7.2 (the last version that doesn't reach for it) to keep
# the probe analysable on Bazel 9. Same pin as the rules_oci probe.
single_version_override(
    module_name = "aspect_bazel_lib",
    version = "2.7.2",
)

node = use_extension("@rules_nodejs//nodejs:extensions.bzl", "node")
use_repo(node, "nodejs_toolchains")
